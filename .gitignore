# ============================================================
#  QQ 志愿活动秒级提醒系统
# ============================================================

# ---------- 敏感信息：绝对不要提交 ----------
# 里面存着 Server酱 SendKey（拿到就能往你微信发推送）
config.json

# ---------- 运行时数据：包含他人聊天内容，不入库 ----------
# logs/ 下还有运行时的 outbox/（推送原图的暂存目录）
logs/
images/
download/

# ---------- 第三方程序本体（约 90 MB，用 tools/fetch_napcat.py 重新获取）----------
# 里面还含有 NapCat WebUI token，属于凭据
napcat/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------- 杂项 ----------
*.bak
*.tmp
*.log
